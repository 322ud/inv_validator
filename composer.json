{
    "name": "kosit/nextcloud-validator",
    "description": "KoSIT Validator app for Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "psr/log": "^3.0"
    },
    "autoload": {
