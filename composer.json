{
    "name": "kosit/nextcloud-validator",
    "description": "KoSIT Validator app for Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^11.5",
        "psr/log": "^3.0",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "autoload": {
        "psr-4": {
            "OCA\\KoSITValidator\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\KoSITValidator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --debug",
        "lint": "phpcs",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
